VITE_API_BASE_URL=http://localhost:5027/api/v1
VITE_API_TIMEOUT_MS=15000

# Auto sign-out: seconds of inactivity before the user is signed out (0 = never), and how many
# of those the "you'll be signed out" countdown covers. Restart the dev server / rebuild after changing.
VITE_IDLE_TIMEOUT_SECONDS=60
VITE_IDLE_WARNING_SECONDS=30
